{
  "name": "psynewview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:dev": "PW_DEV=1 playwright test",
    "test:e2e:smoke": "npm run build && playwright test --grep @smoke",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "test:e2e:ci": "npm run build && playwright test --grep \"@ci\\b\"",
    "tutorials:capture": "PW_DEV=1 playwright test e2e/tutorials"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/lang-python": "^6.1.0",
    "@codemirror/lint": "^6.9.5",
    "@dagrejs/dagre": "^3.0.0",
    "@hpcc-js/wasm-graphviz": "^1.29.2",
    "@types/js-yaml": "^4.0.9",
    "@types/react-plotly.js": "^2.6.4",
    "@uiw/react-codemirror": "^4.21.0",
    "@xyflow/react": "^12.0.0",
    "allotment": "^1.20.0",
    "codemirror": "^6.0.0",
    "js-yaml": "^4.2.0",
    "plotly.js": "^2.30.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-plotly.js": "^2.6.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^2.1.9"
  }
}
